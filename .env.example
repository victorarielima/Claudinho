# Feature Toggles
NEXT_PUBLIC_ENABLE_SHEETS=false

# Google Sheets
GOOGLE_SHEETS_ID=your_google_sheets_id
NEXT_PUBLIC_GOOGLE_SHEETS_ID=your_google_sheets_id
GOOGLE_SERVICE_ACCOUNT_PATH=./secrets/your-service-account.json

# Meta / Facebook Marketing API
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_ACCESS_TOKEN=your_meta_access_token

# FB App IDs por ad account (cross-channel/omnichannel)
# Quando o promoted_object do AdSet nao expoe omnichannel_object.app[0].application_id,
# essas envs sao fallback para construir omnichannel_link_spec.app.application_id.
# Sem isso, o ad sai com "URL do site" preenchida mas "Deep link" vazio,
# e a publicacao manual quebra com erros #100 e #1885876.
# A chave usa o id numerico do ad account (sem o prefixo "act_").
META_APP_ID_775254035944122=your_evino_fb_app_id
META_APP_ID_1020013451372159=your_grandcru_fb_app_id

# Ad Accounts
META_AD_ACCOUNT_EVINO=act_your_evino_account
META_AD_ACCOUNT_GRANDCRU=act_your_grandcru_account

# Pages
META_PAGE_ID_EVINO=your_evino_page_id
META_PAGE_ID_GRANDCRU=your_grandcru_page_id

# Page Access Tokens (long-lived)
META_PAGE_ACCESS_TOKEN_EVINO=your_evino_page_token
META_PAGE_ACCESS_TOKEN_GRANDCRU=your_grandcru_page_token

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Drive - Pasta de vídeos
DRIVE_PASTA_VIDEOS=your_drive_folder_id

# ClickUp
CLICKUP_API_TOKEN=pk_your_clickup_api_token

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret
